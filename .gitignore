# Python 门禁脚本运行缓存
__pycache__/
*.pyc

# TS 构建产物（B2 起 engine/adapters 发布面；CI/发布时现建，不入库——
# ADR 2026-09-08-b2-engine-adapter-ts：git 面只收 TS 源，dist 随包发布）
/dist/

# 本地工具缓存（pnpm store / 组件缓存等工作区态）
/.cache/
node_modules/

# 本地代码索引 / 会话工作目录（开发侧工具生成）
/.codegraph/
/.zcode/
/.saucer/

# 评审简报（一次性调度工件；决策与边界见 ADR 2026-09-05-journal-in-git 的边界段，证据进 journal/HANDOFF）
/.review-briefs/

# 第三方参考仓库本地镜像（调研考古用；MIT 时代快照，证据指针在
# docs/research/evomap-evolver-engine-evolution.md，永不入库）
/.research-mirror/

# 基因库只读消费缓存（P2 共享客户端 pull 目标；不入库——ADR 2026-09-06-p2-shared-consumer）
/.noogenesis/

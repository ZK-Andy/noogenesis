{
  "name": "noogenesis-dsh",
  "version": "0.2.3",
  "description": "Noogenesis (心源) DSH adapter — swarm evolution framework on the DSH plugin architecture: zero-dependency evolution engine (P1) wired into the session lifecycle.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZK-Andy/noogenesis.git"
  },
  "type": "commonjs",
  "main": "dist/adapters/dsh/index.mjs",
  "exports": {
    ".": "./dist/adapters/dsh/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "engine/gates.json",
    "engine/README.md",
    "adapters/dsh/README.md",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').copyFileSync('engine/gates.json','dist/engine/gates.json')\"",
    "release:bump": "node scripts/release/bump.mts",
    "release:note": "node scripts/release/release-note.mts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@types/node": "^22.20.1",
    "lefthook": "^2.1.12",
    "oxlint": "1.82.0",
    "typescript": "^5.9.3"
  }
}

#!/usr/bin/env bash
# pre-push — push 前门禁全跑（最小证据范围内的穷尽；无 .NET 构建面）
# Provenance：蒸馏自 dotnet-deepseek-harness-desktop .githooks/pre-push（MIT）；
# 裁剪：去掉 dotnet build/test；评审机械闸 v0.2 落地——tier 闸以 --enforce
# 挂入（FULL 档 outgoing 缺评审证据即拒推，ADR 2026-09-05-review-mechanical-gate）。
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

echo "== pre-push: 文档与结构门禁 =="

# 变更范围（供人确认；绝不臆测 base）
if [[ -x scripts/change-scope.sh ]]; then
  scripts/change-scope.sh || true
  echo
fi

echo "-> 文档与结构门禁"
python3 scripts/verify-adr-format.py
python3 scripts/verify-doc-budgets.py --manifest scripts/doc-budgets.manifest.json
python3 scripts/verify-md-links.py
python3 scripts/verify-cookbook.py
python3 scripts/verify-skill-format.py
python3 scripts/verify-handoff-structure.py

# 评审档位强制：git 从 stdin 逐行传 "<local_ref> <local_sha> <remote_ref> <remote_sha>"。
# 每个被推 ref 独立 enforce：base = merge-base(remote, local)（收口收窄 outgoing）；
# 新分支首推（remote 全零）无法定 base —— fail-closed 显式报错，不静默豁免
# （R1/R2 评审 2026-09-05：退化工作树态 = outgoing FULL 零拦截的旁路）；
# 分支删除行（local 全零）无 outgoing，跳过；非 push 调用（stdin 为终端）跳过并注明。
echo "-> 评审档位（--enforce）"
if [ -t 0 ]; then
  echo "review-tier: 非 push 调用（stdin 为终端），跳过档位强制"
else
  rc=0
  while read -r lref lsha rref rsha; do
    [[ -n "${lsha:-}" ]] || continue
    [[ "$lsha" =~ ^0+$ ]] && continue
    if [[ "$rsha" =~ ^0+$ ]]; then
      echo "review-tier: FAIL — 新分支首推 $lref 无法定 outgoing base；先实跑 scripts/verify-review-tier.py --since <base> --enforce 并让证据随变更后再推" >&2
      rc=1
      continue
    fi
    mb="$(git merge-base "$rsha" "$lsha" 2>/dev/null || true)"
    if [[ -z "$mb" ]]; then
      echo "review-tier: FAIL — merge-base($rsha, $lsha) 失败（$lref），fail-closed" >&2
      rc=1
      continue
    fi
    if ! python3 scripts/verify-review-tier.py --enforce --since "$mb"; then
      rc=1
    fi
  done
  if [[ $rc -ne 0 ]]; then
    echo "error: 评审档位强制未过（见上）" >&2
    exit 1
  fi
fi

echo "pre-push OK"

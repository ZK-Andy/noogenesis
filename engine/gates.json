{
  "version": 1,
  "gates": [
    { "name": "adr-format", "cmd": "node", "args": ["scripts/verify-adr-format.mts"] },
    { "name": "doc-budgets", "cmd": "node", "args": ["scripts/verify-doc-budgets.mts", "--manifest", "scripts/doc-budgets.manifest.json"] },
    { "name": "md-links", "cmd": "node", "args": ["scripts/verify-md-links.mts"] },
    { "name": "cookbook", "cmd": "node", "args": ["scripts/verify-cookbook.mts"] },
    { "name": "skill-format", "cmd": "node", "args": ["scripts/verify-skill-format.mts"] },
    { "name": "archived-notes", "cmd": "node", "args": ["scripts/verify-archived-agent-notes.mts"] },
    { "name": "postmortem-naming", "cmd": "node", "args": ["scripts/verify-postmortem-naming.mts"] },
    { "name": "handoff-structure", "cmd": "node", "args": ["scripts/verify-handoff-structure.mts"] },
    { "name": "manifest", "cmd": "node", "args": ["scripts/verify-manifest.mts"] },
    { "name": "review-tier", "cmd": "node", "args": ["scripts/verify-review-tier.mts", "--since", "{{outgoing_base}}", "--enforce"] },
    { "name": "review-brief", "cmd": "node", "args": ["scripts/verify-review-brief.mts", "--lanes", "R1,R2,R3"] },
    { "name": "change-scope", "cmd": "node", "args": ["scripts/change-scope.mts", "{{outgoing_base}}", "{{head}}"] },
    { "name": "lint", "cmd": "node", "args": ["scripts/verify-lint.mts"] },
    { "name": "export-docs", "cmd": "node", "args": ["scripts/verify-export-docs.mts"] },
    { "name": "package-invariants", "cmd": "node", "args": ["scripts/verify-package-invariants.mts"] },
    { "name": "ts-typecheck", "cmd": "node", "args": ["node_modules/typescript/bin/tsc", "--noEmit"] }
  ]
}
